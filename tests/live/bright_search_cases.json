    {
      "id": "company-ludicrous",
      "group": "smoke",
      "category": "company",
      "request": {
        "mode": "ludicrous",
        "query": {
          "and": [
            {
              "text": {
                "industry": "software"
              }
            },
            {
              "equals": {
                "headquarters_country_code": "US"
